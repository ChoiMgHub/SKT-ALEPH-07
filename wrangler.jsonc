{
  "name": "skt-aleph-07",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/diary",
      "/diary/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aleph-diary-07",
      "database_id": "e8f195cd-4038-422c-bd47-70f5ebebc3ea"
    }
  ]
}
